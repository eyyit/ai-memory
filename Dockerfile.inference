FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir 'torch>=2.6,<3' --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir '.[inference]' && groupadd --gid 10002 ai-memory && useradd --uid 10002 --gid 10002 --shell /usr/sbin/nologin --create-home ai-memory
RUN python -m compileall -q /app/src
USER 10002:10002
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
CMD ["uvicorn", "ai_memory.inference:app", "--host", "0.0.0.0", "--port", "8081", "--no-access-log"]
