FROM python:3.12-slim
WORKDIR /app
COPY gateway/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && groupadd --gid 10002 ai-memory && useradd --uid 10002 --gid 10002 --shell /usr/sbin/nologin --create-home ai-memory
COPY gateway /app/gateway
RUN python -m compileall -q /app/gateway
USER 10002:10002
CMD ["uvicorn", "gateway.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8082", "--no-access-log"]
